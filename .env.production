# GeoSpark Production Environment
# Copy to .env and fill in your values

# === Required ===
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Cloudflare Tunnel (get from Cloudflare Zero Trust dashboard) ===
# 1. Go to https://one.dash.cloudflare.com
# 2. Networks > Tunnels > Create a tunnel
# 3. Choose "Cloudflared" connector
# 4. Copy the tunnel token
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# === Optional: Supabase (for spatial database features) ===
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

# === Server Config ===
GEOSPARK_ENV=production
GEOSPARK_LOG_LEVEL=info
