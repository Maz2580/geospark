# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
*.whl

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Environment / Secrets
.env
.env.production
*.env.local

# Data (large binary files -- use Git LFS or keep in data/)
data/
*.tif
*.tiff
*.shp
*.dbf
*.shx
*.prj
*.gpkg
*.geojson.gz

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml
test_academic/

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# Docker
docker-compose.override.yml

# Resources (cloned reference repos -- not part of GeoSpark)
resources/

# Internal docs (keep locally, not public)
docs/PRD.md
docs/BUSINESS_PLAN.md
docs/ROADMAP.md
docs/launch/
docs/superpowers/

# Claude Code
.claude/
verification_roadmap.md
docs/UI_IMPLEMENTATION_PLAN.md
docs/FLOW_PERSISTENCE_PLAN.md

# Server-only: Valhalla routing data, Docker build metadata, config backups (never committed)
valhalla/
overpass/
.buildx/
*.bak-*

# Copies of .env (e.g. .env.backup) hold the same secrets: never commit them.
# .env.example is the secret-free template and stays tracked.
.env.*
!.env.example

# Server-side change checks (deploy/DEPLOY.md)
.containers-before
.change-start

# Re-check harness output (scores are summarised in docs/benchmarks/2026-10/results_summary.json)
docs/benchmarks/*/results/
docs/benchmarks/*/proj/
docs/benchmarks/*/.data/
docs/benchmarks/*/codegen/venv/
docs/benchmarks/*/codegen/results_*.json
