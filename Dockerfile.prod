# Production Dockerfile -- optimized for free-tier VMs (1-4GB RAM)
# Multi-stage build: ~400MB final image vs ~1.2GB with [all] deps

# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md ./
COPY geospark/ geospark/

# Install core + api + intelligence deps (FAISS for vector search acceleration)
RUN pip install --no-cache-dir --prefix=/install ".[api,intelligence]"

# Stage 2: Runtime
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgeos-dev \
    libproj-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

WORKDIR /app
COPY geospark/ geospark/
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --no-deps -e .

# Non-root user for security
RUN useradd -m -r geospark && chown -R geospark:geospark /app
USER geospark

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "geospark.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
