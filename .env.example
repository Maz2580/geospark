# GeoSpark Environment Configuration
# Copy this file to .env and fill in your values

# OpenRouter (free LLM access with tool calling)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEOSPARK_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Supabase (free PostgreSQL + PostGIS database)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# Docker PostGIS (alternative to Supabase)
DB_PASSWORD=geospark_dev

# LLM API Keys (optional - for future paid tiers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Data Provider API Keys (optional)
PLANET_API_KEY=
MAPBOX_TOKEN=

# GeoSpark Configuration
GEOSPARK_DB_BACKEND=memory  # memory, supabase, spatialite, duckdb, postgis
GEOSPARK_CACHE_ENABLED=true
GEOSPARK_LOG_LEVEL=info

# --- Security (public API) ---
# The public API stays open; these protect operator routes and the shared server.
# Required when GEOSPARK_ENV=production: the server refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GEOSPARK_ENV=development
GEOSPARK_ADMIN_TOKEN=
# Comma-separated partner keys that open only the LLM gateway (/api/v1/llm/chat|generate|embeddings)
GEOSPARK_GATEWAY_KEYS=
# Optional: require a key on public routes too (unset = open public API)
GEOSPARK_API_KEY=
# Extra models public callers may pick (the local Ollama model and OpenRouter :free models are always allowed)
GEOSPARK_ALLOWED_MODELS=
# Concurrent LLM/agent requests before answering 503 (protects a shared CPU)
GEOSPARK_MAX_LLM_CONCURRENCY=2
# Requests per minute per client IP: default routes, and expensive routes (ask, agents, memory, flows/build)
GEOSPARK_RATE_LIMIT_RPM=60
GEOSPARK_RATE_LIMIT_EXPENSIVE_RPM=12
GEOSPARK_MAX_BODY_BYTES=1048576
# Per-visitor demo sandboxes (Memory and Context pages)
GEOSPARK_SANDBOX_TTL_DAYS=7
GEOSPARK_SANDBOX_MAX_MEMORIES=200
GEOSPARK_SANDBOX_MAX_CONTEXTS=100
# Hosted MCP over Streamable HTTP at /mcp (public, read-only, rate-limited). Off unless "true".
GEOSPARK_MCP_HTTP=false
GEOSPARK_RATE_LIMIT_MCP_RPM=60
# Overture Maps (DuckDB): resource caps per query, and an optional pinned release
GEOSPARK_DUCKDB_THREADS=4
GEOSPARK_DUCKDB_MEMORY=512MB
GEOSPARK_OVERTURE_RELEASE=
GEOSPARK_OVERTURE_CONCURRENCY=1
# Self-hosted Overpass (OpenStreetMap queries) for one region, asked first for points inside it;
# public Overpass servers otherwise. See deploy/OVERPASS_SELFHOST_PLAN.md.
GEOSPARK_OVERPASS_URL=
# Its coverage as a Geofabrik/Osmosis .poly file (default: the bundled Australia boundary)
GEOSPARK_OVERPASS_POLY=
