# Production Dockerfile -- optimized for free-tier VMs (1-4GB RAM)
# Multi-stage build: ~400MB final image vs ~1.2GB with [all] deps

# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md ./
COPY geospark/ geospark/

# Install core + api + intelligence (FAISS) + terrain + mcp (for the optional hosted /mcp endpoint)
RUN pip install --no-cache-dir --prefix=/install ".[api,intelligence,terrain,mcp]"

# Stage 2: Runtime
FROM python:3.11-slim

# libexpat1: the rasterio wheel links the system expat (Copernicus DEM reads)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgeos-dev \
    libproj-dev \
    libexpat1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

WORKDIR /app
COPY geospark/ geospark/
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --no-deps -e .

# Non-root user for security. Its uid matches the host user that owns the mounted ./data
# directory (ubuntu = 1000 on the VM), so state written to /app/data survives redeploys.
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} geospark \
    && useradd -m -r -u ${APP_UID} -g ${APP_GID} geospark \
    && mkdir -p /app/data \
    && chown -R geospark:geospark /app
USER geospark

# All persistent state (audit log, usage counters, memory/context sandboxes) lives here;
# docker-compose.prod.yml mounts ./data on it.
ENV GEOSPARK_DATA_DIR=/app/data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "geospark.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
